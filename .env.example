# Copy to .env.local (or export these directly) and fill in your own endpoint.
# Any OpenAI-compatible chat-completions endpoint works: a local llama.cpp/vLLM
# server, a hosted API, or a compatible proxy in front of another provider.

# --- cheap layer: used for the mutation operator, called many times per run ---
FORGE_CHEAP_BASE_URL=http://localhost:8000/v1
FORGE_CHEAP_MODEL=your-cheap-model-name
FORGE_CHEAP_API_KEY=

# --- smart layer: used for the final review pass, called a handful of times per run ---
FORGE_SMART_BASE_URL=http://localhost:8000/v1
FORGE_SMART_MODEL=your-smart-model-name
FORGE_SMART_API_KEY=

# Optional per-layer knobs (see forge/llm.py docstring for the full list):
#   FORGE_{CHEAP,SMART}_THINKING=disabled   suppress reasoning-model thinking blocks
#   FORGE_{CHEAP,SMART}_TIMEOUT=30          HTTP timeout in seconds
#   FORGE_{CHEAP,SMART}_FALLBACKS='[...]'   JSON array of {base_url,api_key,model,...} to try in order on failure
#   FORGE_{CHEAP,SMART}_POOL='[...]'        JSON array of endpoints to round-robin across for diversity
#   FORGE_{CHEAP,SMART}_CLI='[...]'         JSON argv array to shell out to a subscription CLI instead of HTTP
#   FORGE_MOCK=1                            skip the network entirely and use the built-in MockLLM
